\"fontSize\":24,\"fontWeight\":700,\"color\":\"#0a0a0a\",\"marginTop\":32,\"marginBottom\":12,\"letterSpacing\":\"-0.01em\"},\"children\":\"Canvas dimensions versus image detail\"}],[\"$\",\"p\",\"2\",{\"style\":{\"color\":\"#3d2f2c\",\"fontSize\":16,\"lineHeight\":1.75,\"margin\":\"12px 0\"},\"children\":\"BgRemove exports a 3840 × 2160 pixel canvas and centers the cutout while preserving its proportions. If the original image is smaller, it may be enlarged to fit; the larger pixel dimensions do not create detail that was absent from the source.\"}],[\"$\",\"h2\",\"3\",{\"style\":{\"fontFamily\":\"'Space Grotesk', sans-serif\",\"fontSize\":24,\"fontWeight\":700,\"color\":\"#0a0a0a\",\"marginTop\":32,\"marginBottom\":12,\"letterSpacing\":\"-0.01em\"},\"children\":\"When to keep transparency or add white\"}],[\"$\",\"ul\",\"4\",{\"style\":{\"paddingLeft\":22,\"margin\":\"12px 0\",\"color\":\"#3d2f2c\",\"lineHeight\":1.7},\"children\":[[\"$\",\"li\",\"0\",{\"style\":{\"marginBottom\":6},\"children\":\"Keep transparency when you will place the subject over another background.\"}],[\"$\",\"li\",\"1\",{\"style\":{\"marginBottom\":6},\"children\":\"Choose a white background when a design or listing calls for a plain white image.\"}],[\"$\",\"li\",\"2\",{\"style\":{\"marginBottom\":6},\"children\":\"Check the requirements of the destination before preparing product or document photos.\"}]]}],[\"$\",\"h2\",\"5\",{\"style\":{\"fontFamily\":\"'Space Grotesk', sans-serif\",\"fontSize\":24,\"fontWeight\":700,\"color\":\"#0a0a0a\",\"marginTop\":32,\"marginBottom\":12,\"letterSpacing\":\"-0.01em\"},\"children\":\"Check the image before using it\"}],[\"$\",\"ol\",\"6\",{\"style\":{\"paddingLeft\":22,\"margin\":\"12px 0\",\"color\":\"#3d2f2c\",\"lineHeight\":1.7},\"children\":[[\"$\",\"li\",\"0\",{\"style\":{\"marginBottom\":6},\"children\":\"View the PNG over both a light and a dark background to spot unwanted edge pixels.\"}],[\"$\",\"li\",\"1\",{\"style\":{\"marginBottom\":6},\"children\":\"Inspect fine details such as hair, fur, glass, or shadows.\"}],[\"$\",\"li\",\"2\",{\"style\":{\"marginBottom\":6},\"children\":\"Compare the result with the original and check that the cutout has enough detail for its intended size.\"}]]}],[\"$\",\"p\",\"7\",{\"style\":{\"color\":\"#3d2f2c\",\"fontSize\":16,\"lineHeight\":1.75,\"margin\":\"12px 0\"},\"children\":\"PNG supports transparency; JPEG does not. If you save the cutout as JPEG in another app, that app must fill transparent pixels with a background color.\"}]]]}]\n14:[\"$\",\"p\",null,{\"style\":{\"marginTop\":40,\"color\":\"#3d2f2c\",\"fontSize\":15,\"lineHeight\":1.7},\"children\":[\"Ready to try it?\",\" \",[\"$\",\"$L37\",null,{\"href\":\"/#upload\",\"style\":{\"color\":\"#EB4203\",\"fontWeight\":600},\"children\":\"Open the free background remover\"}],\".\"]}]\n15:[\"$\",\"section\",null,{\"style\":{\"marginTop\":64,\"paddingTop\":32,\"borderTop\":\"1px solid rgba(235,66,3,0.15)\"},\"children\":[[\"$\",\"h2\",null,{\"style\":{\"fontFamily\":\"'Space Grotesk', sans-serif\",\"fontSize\":20,\"fontWeight\":700,\"color\":\"#0a0a0a\",\"marginBottom\":20},\"children\":\"Related articles\"}],[\"$\",\"div\",null,{\"style\":{\"display\":\"grid\",\"gap\":14},\"children\":[[\"$\",\"$L37\",\"remove-background-from-product-photos\",{\"href\":\"/blog/remove-background-from-product-photos\",\"style\":{\"padding\":16,\"borderRadius\":14,\"background\":\"rgba(255,255,255,0.6)\",\"border\":\"1px solid rgba(235,66,3,0.15)\",\"textDecoration\":\"none\",\"color\":\"inherit\",\"transition\":\"all 0.25s ease\"},\"children\":[[\"$\",\"div\",null,{\"style\":{\"fontWeight\":600,\"color\":\"#0a0a0a\",\"fontSize\":15},\"children\":\"How to Remove a Background from Product Photos\"}],[\"$\",\"div\",null,{\"style\":{\"color\":\"#5a4a47\",\"fontSize\":13,\"marginTop\":4},\"children\":\"A practical workflow for preparing product image cutouts while keeping listing rules, edges, and image quality in mind.\"}]]}],[\"$\",\"$