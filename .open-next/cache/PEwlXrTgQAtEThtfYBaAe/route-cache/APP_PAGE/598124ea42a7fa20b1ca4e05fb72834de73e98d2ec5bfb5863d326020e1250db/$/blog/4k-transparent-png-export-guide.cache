dren\":\"A transparent PNG stores a subject without filling the surrounding canvas with a solid color. This lets you place a cutout over a different color, photo, or layout in an editor.\"}],[\"$\",\"h2\",\"1\",{\"style\":{\"fontFamily\":\"'Space Grotesk', sans-serif\",\"fontSize\":24,\"fontWeight\":700,\"color\":\"#0a0a0a\",\"marginTop\":32,\"marginBottom\":12,\"letterSpacing\":\"-0.01em\"},\"children\":\"Canvas dimensions versus image detail\"}],[\"$\",\"p\",\"2\",{\"style\":{\"color\":\"#3d2f2c\",\"fontSize\":16,\"lineHeight\":1.75,\"margin\":\"12px 0\"},\"children\":\"BgRemove exports a 3840 × 2160 pixel canvas and centers the cutout while preserving its proportions. If the original image is smaller, it may be enlarged to fit; the larger pixel dimensions do not create detail that was absent from the source.\"}],[\"$\",\"h2\",\"3\",{\"style\":{\"fontFamily\":\"'Space Grotesk', sans-serif\",\"fontSize\":24,\"fontWeight\":700,\"color\":\"#0a0a0a\",\"marginTop\":32,\"marginBottom\":12,\"letterSpacing\":\"-0.01em\"},\"children\":\"When to keep transparency or add white\"}],\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\"]]}],\"$L20\",\"$L21\",\"$L22\"]}]\n1c:[\"$\",\"ul\",\"4\",{\"style\":{\"paddingLeft\":22,\"margin\":\"12px 0\",\"color\":\"#3d2f2c\",\"lineHeight\":1.7},\"children\":[[\"$\",\"li\",\"0\",{\"style\":{\"marginBottom\":6},\"children\":\"Keep transparency when you will place the subject over another background.\"}],[\"$\",\"li\",\"1\",{\"style\":{\"marginBottom\":6},\"children\":\"Choose a white background when a design or listing calls for a plain white image.\"}],[\"$\",\"li\",\"2\",{\"style\":{\"marginBottom\":6},\"children\":\"Check the requirements of the destination before preparing product or document photos.\"}]]}]\n1d:[\"$\",\"h2\",\"5\",{\"style\":{\"fontFamily\":\"'Space Grotesk', sans-serif\",\"fontSize\":24,\"fontWeight\":700,\"color\":\"#0a0a0a\",\"marginTop\":32,\"marginBottom\":12,\"letterSpacing\":\"-0.01em\"},\"children\":\"Check the image before us