{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/page,_N_T_/,_N_T_/index"},"segmentPaths":["/_tree","/_full","/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":160,"slots":null}}},"routeCache":{"key":"/route-cache/APP_PAGE/c6377dd9ce6a1c2cd100eb4344e843eb4639b9ed26f84643f77680e9eb454c4b/$/index","owner":{"kind":"APP_PAGE","sourceRoute":"/page"},"isFallback":false}},"html":"<!DOCTYPE html><html lang=\"en\" style=\"background-color:#fff1ef\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=5\"/><link rel=\"stylesheet\" href=\"/_next/static/css/1241507da07444c3.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-c05636e6ec78cb3e.js\"/><script src=\"/_next/static/chunks/4bd1b696-c7408084347438ae.js\" async=\"\"></script><script src=\"/_next/static/chunks/794-3c1567673e1f8cb7.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-da0c10eb7f5c95b0.js\" async=\"\"></script><script src=\"/_next/static/chunks/500-fc3b64d9ff4a32a7.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-2f357be979fb0f07.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/page-9324ca4a2b35533f.js\" async=\"\"></script><link rel=\"preload\" href=\"https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&amp;family=Space+Grotesk:wght@600;700&amp;display=swap\" as=\"style\"/><link rel=\"preconnect\" href=\"https://fonts.googleapis.com\"/><link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"anonymous\"/><meta name=\"theme-color\" content=\"#fff1ef\" media=\"(prefers-color-scheme: light)\"/><meta name=\"theme-color\" content=\"#fff1ef\" media=\"(prefers-color-scheme: dark)\"/><meta name=\"color-scheme\" content=\"light\"/><title>Free Online Background Remover</title><meta name=\"descriptio